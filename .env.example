# The local configuration: the one place the users, passwords and hosts are set. Docker
# Compose hands it to every container as it is, so nothing needs copying. To change a value
# without touching this file, put it in .env (git ignores it), which Compose reads after
# this one. Hosts are Compose service names.

# Postgres: the image creates this user and database; Kart connects with them.
POSTGRES_HOST=postgres
POSTGRES_USER=kart
POSTGRES_PASSWORD=kart
POSTGRES_DB=kart

# RabbitMQ: the image creates this user; Kart connects with it.
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=kart
RABBITMQ_DEFAULT_PASS=kart

# Keycloak: the admin console login, and where Kart reaches Keycloak.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080

# Observability: where every Kart process exports its traces over OTLP (HTTP), here the local
# Jaeger. Leave it empty to export nothing. Set SENTRY_DSN, in .env, to report errors to Sentry.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
