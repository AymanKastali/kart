# Copy to .env (git ignores it): `cp .env.example .env`. It is the one place the local
# users, passwords and hosts are set. Docker Compose hands it to every container, where the
# hosts become the Compose service names; `uv run` on the host reads it as it is.

# Postgres: the image creates this user and database; Kart connects with them.
POSTGRES_HOST=localhost
POSTGRES_USER=kart
POSTGRES_PASSWORD=kart
POSTGRES_DB=kart

# RabbitMQ: the image creates this user; Kart connects with it.
RABBITMQ_HOST=localhost
RABBITMQ_DEFAULT_USER=kart
RABBITMQ_DEFAULT_PASS=kart

# Keycloak: the admin console login, and where Kart reaches Keycloak.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
