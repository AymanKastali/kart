{
  "realm": "kart",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Buys from Sellers."
      },
      {
        "name": "seller",
        "description": "Lists Products and fulfils Orders."
      },
      {
        "name": "operator",
        "description": "Runs the marketplace."
      }
    ]
  },
  "clients": [
    {
      "clientId": "kart-api",
      "name": "Kart API",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "kart-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "kart-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer",
      "email": "customer@kart.local",
      "firstName": "Local",
      "lastName": "Customer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-kart",
        "customer"
      ]
    },
    {
      "username": "seller",
      "email": "seller@kart.local",
      "firstName": "Local",
      "lastName": "Seller",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "seller",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-kart",
        "seller"
      ]
    },
    {
      "username": "operator",
      "email": "operator@kart.local",
      "firstName": "Local",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-kart",
        "operator"
      ]
    }
  ]
}
