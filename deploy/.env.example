# Copy to deploy/.env, which git ignores. Compose reads it to fill in deploy/compose.yaml,
# and builds the app's DATABASE_URL, RABBITMQ_URL and KEYCLOAK_URL from these values.
POSTGRES_USER=kart
POSTGRES_PASSWORD=kart
POSTGRES_DB=kart

RABBITMQ_USER=kart
RABBITMQ_PASSWORD=kart

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
