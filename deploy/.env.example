# Optional. Copy to deploy/.env (git ignores it) to override the defaults in
# deploy/compose.yaml, which builds the app's DATABASE_URL, RABBITMQ_URL and KEYCLOAK_URL
# from these values. To run the app outside Compose, set those three URLs yourself.
POSTGRES_USER=kart
POSTGRES_PASSWORD=kart
POSTGRES_DB=kart

RABBITMQ_USER=kart
RABBITMQ_PASSWORD=kart

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
