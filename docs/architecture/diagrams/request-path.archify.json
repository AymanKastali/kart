  "cards": [
    {
      "dot": "emerald",
      "title": "Never lost, never twice",
      "items": [
        "The event commits with the state change, or neither does",
        "No process polls the outbox: Debezium reads the write-ahead log",
        "The inbox makes a redelivered event harmless"
      ]
    },
    {
      "dot": "violet",
      "title": "One trace end to end",
      "items": [
        "The trace context travels in the envelope body, because Debezium overwrites the traceparent header (ADR-0011)",
        "Every log line is JSON with the trace id while a span is active"
      ]
    },
    {
      "dot": "amber",
      "title": "Not yet exercised",
      "items": [
        "No route publishes an event and no context subscribes yet; Slice 1 adds the first"
      ]
    }
