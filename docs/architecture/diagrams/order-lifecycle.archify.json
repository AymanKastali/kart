  "cards": [
    {
      "dot": "cyan",
      "title": "Checkout",
      "items": [
        "Placing saves every amount before stock is reserved",
        "Reservation is all lines or none, idempotent per Order",
        "Scheduler retries Orders stuck in placing"
      ]
    },
    {
      "dot": "amber",
      "title": "Card payment window",
      "items": [
        "Declined cards can be retried for 30 minutes",
        "Payments cancels the card payment before the Order is cancelled",
        "A payment that already succeeded confirms the Order instead"
      ]
    },
    {
      "dot": "rose",
      "title": "After confirmation",
      "items": [
        "The Order records each Shipment's outcome from shipment.* events",
        "Amounts never change; refunds belong to Payments",
