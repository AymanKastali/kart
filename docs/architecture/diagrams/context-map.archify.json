  "cards": [
    {
      "dot": "cyan",
      "title": "How to read it",
      "items": [
        "Arrows point upstream → downstream",
        "Solid: synchronous call through contracts",
        "Dashed: integration event via outbox → RabbitMQ"
      ]
    },
    {
      "dot": "emerald",
      "title": "Relationships",
      "items": [
        "Offer, Catalog → Ordering: customer–supplier",
        "Payment → Ordering: open host service",
        "Ordering → Fulfilment: customer–supplier",
        "Fulfilment → others: published language",
        "Payment ↔ Stripe: anti-corruption layer"
      ]
    },
    {
      "dot": "amber",
      "title": "Not drawn as arrows",
      "items": [
        "Identity is an open host service to every context (OIDC token)",
        "Notification also reacts to Ordering, Fulfilment, Seller Onboarding and Catalog events",
        "Ordering never reads Discovery at checkout"
      ]
    }
  ]
