  "cards": [
    {
      "dot": "cyan",
      "title": "Synchronous",
      "items": [
        "Checkout and the payment timeout call other contexts directly, through their contracts",
        "Ordering never reads Discovery"
      ]
    },
    {
      "dot": "orange",
      "title": "Choreography",
      "items": [
        "Everything after checkout is events, no orchestrator",
        "Consumers dedupe by event id in their inbox"
      ]
    },
    {
      "dot": "rose",
      "title": "Timeouts",
      "items": [
        "Unpaid after 30 min or abandoned → cancel card payment, then order.cancelled → Offer releases stock",
        "Declined cards can be retried within the window",
        "Scheduler retries Orders stuck in placing"
      ]
    }
  ]
